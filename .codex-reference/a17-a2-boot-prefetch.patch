+        );
+        rf.insert_record(Record { file_id: FileId(0), offset: 8, length: 4, timestamp: 0 });
+
+        let serialized = rf.add_checksum_and_serialize().unwrap();
+        assert!(serde_cbor::from_slice::<RecordsFile>(&serialized).is_ok());
+    }
 }
